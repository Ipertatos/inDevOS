+/* type="module" (case-insensitive, surrounding space ignored) */
+static bool html_script_is_module(struct dom_string *mt)
+{
+	const char *d;
+	size_t l;
+	if (mt == NULL) return false;
+	d = dom_string_data(mt);
+	l = dom_string_byte_length(mt);
+	while (l > 0 && (*d == ' ' || *d == '\t')) { d++; l--; }
+	while (l > 0 && (d[l-1] == ' ' || d[l-1] == '\t')) l--;
+	return l == 6 && strncasecmp(d, "module", 6) == 0;
+}
