+/* Object arrivals reformat the whole page.  A page with many objects
+ * (Wikipedia: hundreds of SVG images, each READY with a reformattable
+ * content) laid itself out once per object, seconds of layout per burst.
+ * Throttle like the incremental reflow (next reformat no sooner than 3x the
+ * cost of the last one) and run one deferred reformat for those skipped. */
+static void html_object_deferred_reformat(void *p)
+{
+	html_content *c = p;
+
+	c->reformat_pending = false;
+	if (c->layout != NULL && !c->reflowing &&
+	    (c->base.status == CONTENT_STATUS_READY ||
+	     c->base.status == CONTENT_STATUS_DONE))
+		content__reformat(&c->base, false, c->base.available_width,
+				  c->base.available_height);
+}
+
+static void html_object_reformat(html_content *c)
+{
+	uint64_t ms_now;
+
+	nsu_getmonotonic_ms(&ms_now);
+	if (ms_now > c->base.reformat_time) {
+		html_object_cancel_reformat(c);
+		content__reformat(&c->base, false, c->base.available_width,
+				  c->base.available_height);
+	} else if (!c->reformat_pending) {
+		c->reformat_pending = true;
+		guit->misc->schedule((int)(c->base.reformat_time - ms_now) + 1,
+				     html_object_deferred_reformat, c);
+	}
+}
+
+void html_object_cancel_reformat(html_content *c)
+{
+	if (c->reformat_pending) {
+		guit->misc->schedule(-1, html_object_deferred_reformat, c);
+		c->reformat_pending = false;
+	}
+}
+
