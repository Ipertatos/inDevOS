+/* forms_orphans: controls outside any form hang off their node */
+#include "html/box.h"
+#include "html/box_construct.h"
+static dom_string *orphan_key;
+
+static struct form_control *orphan_get(dom_node *node)
+{
+	void *data = NULL;
+	if (orphan_key == NULL && dom_string_create(
+			(const uint8_t *) "__ns_orphan_ctl", 15,
+			&orphan_key) != DOM_NO_ERR)
+		return NULL;
+	if (dom_node_get_user_data(node, orphan_key, &data) != DOM_NO_ERR)
+		return NULL;
+	return data;
+}
+
+static void orphan_set(dom_node *node, struct form_control *ctl)
+{
+	void *old = NULL;
+	if (orphan_key == NULL)
+		return;
+	dom_node_set_user_data(node, orphan_key, ctl, NULL, &old);
+}
+
+void html_forms_free_orphans(struct box *root, bool unused_only)
+{
+	struct box *b = root;
+	while (b != NULL) {
+		struct form_control *g = b->gadget;
+		/* identify orphans by node data only: form-owned controls
+		 * may already be freed (html_destroy frees forms first) */
+		if (g != NULL && b->node != NULL &&
+		    orphan_get(b->node) == g) {
+			struct box *nb = box_for_node(b->node);
+			if (!unused_only || nb == NULL || nb->gadget != g) {
+				orphan_set(b->node, NULL);
+				if (g->box == b || (nb != NULL && nb->gadget != g))
+					g->box = NULL;
+				form_free_control(g);
+			}
+		}
+		/* pre-order walk */
+		if (b->children != NULL) {
+			b = b->children;
+			continue;
+		}
+		while (b != NULL && b != root && b->next == NULL)
+			b = b->parent;
+		if (b == NULL || b == root)
+			break;
+		b = b->next;
+	}
+}
+
